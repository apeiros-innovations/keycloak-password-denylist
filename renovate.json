{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "semanticCommits": "enabled",
  "extends": ["config:best-practices", "group:allNonMajor", "github>apeiros-innovations/renovate-config//mise.json5#main"],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Keep SecLists source and package release versions aligned",
      "matchManagers": ["vendir"],
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["danielmiessler/SecLists"],
      "groupName": "SecLists",
      "semanticCommitType": "chore",
      "semanticCommitScope": "seclists",
      "commitMessageAction": "update",
      "commitMessageTopic": "SecLists to {{{newVersion}}}",
      "commitBody": "Release-As: {{{newVersion}}}.1"
    }
  ]
}
