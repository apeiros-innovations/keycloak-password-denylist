{
  "version": 1,
  "ignore_paths": [
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "AGENTS.md",
    "LICENSE",
    "LICENSES/**",
    "THIRD_PARTY_NOTICES.md",
    ".vscode/**",
    ".editorconfig",
    ".lefthook.yaml",
    ".lefthook/**",
    ".commitlintrc.yaml",
    ".betterleaks.toml",
    ".betterleaksignore",
    ".renovaterc.json5",
    "renovate.json",
    ".github/renovate.json"
  ],
  "ignore_tools": [
    "aqua:betterleaks/betterleaks",
    "aqua:evilmartians/lefthook",
    "npm:@commitlint/cli",
    "npm:@commitlint/config-conventional"
  ],
  "jobs": {
    "workflows": {
      "paths": [
        ":(top,glob)**",
        ":(exclude)README.md",
        ":(exclude)CHANGELOG.md",
        ":(exclude)CONTRIBUTING.md",
        ":(exclude)AGENTS.md",
        ":(exclude)LICENSE",
        ":(exclude)LICENSES/**",
        ":(exclude)THIRD_PARTY_NOTICES.md",
        ":(exclude).vscode/**",
        ":(exclude).editorconfig",
        ":(exclude).commitlintrc.yaml",
        ":(exclude).betterleaks.toml",
        ":(exclude).betterleaksignore",
        ":(exclude).renovaterc.json5",
        ":(exclude)renovate.json",
        ":(exclude).github/renovate.json",
        ".github/workflows/workflow-lint.yaml"
      ],
      "tools": [
        "python",
        "aqua:kjanat/actionlint",
        "aqua:rhysd/actionlint",
        "aqua:zizmorcore/zizmor",
        "aqua:koalaman/shellcheck"
      ],
      "needs": []
    }
  }
}
